{
	"name": "ooxml",
	"private": true,
	"description": "The ooxml-core library, the shared ooxml-ui elements, the MCP servers and the Word, Excel, Visio, OpenTeams and OpenMail viewers, in one workspace",
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/ooxml.git"
	},
	"workspaces": [
		"src/core",
		"src/ui",
		"mcp",
		"viewers/*",
		"viewers/*/packages/*",
		"viewers/*/mcp",
		"viewers/*/docs",
		"viewers/teams/server",
		"demos/docx",
		"demos/xlsx",
		"demos/visio",
		"demos/teams",
		"apps/office-suite",
		"e2e/docx",
		"e2e/xlsx",
		"e2e/visio",
		"e2e/teams",
		"demos/teams/*",
		"demos/pptx",
		"demos/pptx/demo-*",
		"e2e/pptx",
		"demos/mail",
		"demos/mail/*",
		"e2e/mail"
	],
	"type": "module",
	"scripts": {
		"build": "bun run --cwd src/core build",
		"build:suite": "bun run build && bun run --cwd src/ui build && node scripts/build-suite.mjs",
		"preview:suite": "node scripts/preview-site.mjs",
		"test:suite": "node scripts/suite-browser-check.mjs",
		"test:suite:profile": "node scripts/suite-profile-check.mjs",
		"build:visio": "bun run --cwd src/core build:visio",
		"typecheck": "bun run --cwd src/core typecheck",
		"typecheck:strict": "bun run --cwd src/core typecheck:strict",
		"typecheck:pptx": "bun run --cwd src/core typecheck:pptx",
		"test": "bun run --cwd src/core test",
		"test:package": "bun run --cwd src/core test:package",
		"gen:docx-schema-types": "bun run --cwd src/core gen:docx-schema-types",
		"fmt": "oxfmt '!viewers/**'",
		"fmt:check": "oxfmt --check '!viewers/**'",
		"test:scripts": "node --test 'scripts/*.test.mjs'",
		"verify": "node scripts/verify.mjs",
		"check:changelog": "node scripts/check-changelog-sections.mjs",
		"fleet": "node scripts/fleet.mjs",
		"release:plan": "node scripts/release-plan.mjs",
		"release:publish": "node scripts/publish-released.mjs",
		"changelog:unreleased": "bunx git-cliff --config cliff.toml --tag-pattern \"^ooxml-core@\" --unreleased",
		"test:mcp": "node --test mcp/test/*.test.js",
		"lint": "oxlint --ignore-pattern=viewers/",
		"lint:fix": "oxlint --fix --ignore-pattern=viewers/",
		"test:suite:regressions": "node scripts/suite-regression-check.mjs",
		"test:suite:pptx-chart": "node scripts/suite-pptx-chart-check.mjs",
		"test:suite:files": "node scripts/suite-files-check.mjs",
		"test:suite:visio-presentation": "node scripts/suite-visio-presentation-check.mjs"
	},
	"devDependencies": {
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0"
	},
	"overrides": {
		"argparse": "^2.0.1",
		"esbuild": "^0.28.2"
	},
	"engines": {
		"node": ">=22"
	}
}
