{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rootDir": ".",
		"outDir": ".release-types",
		"types": ["node"]
	},
	"include": ["packages/*/src/**/*.ts"],
	"exclude": ["packages/**/*.test.ts", "packages/**/dist/**", "**/node_modules/**"]
}
