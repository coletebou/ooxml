{
	"name": "@christophervr/xlsx-react-viewer",
	"version": "1.1.0",
	"description": "React component for the Excel spreadsheet editor. Self-contained: includes the editor, the formula engine and the legacy .xls reader.",
	"keywords": [
		"editor",
		"excel",
		"react",
		"spreadsheet",
		"xls",
		"xlsx"
	],
	"homepage": "https://christophervr.github.io/ooxml/xlsx/",
	"bugs": {
		"url": "https://github.com/ChristopherVR/ooxml/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/ooxml.git",
		"directory": "viewers/xlsx/packages/react"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@christophervr/xlsx-core": "^0.3.0",
		"ooxml-core": "*",
		"ooxml-ui": "*"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react-dom": "^19.3.1"
	},
	"peerDependencies": {
		"react": ">=18"
	}
}
