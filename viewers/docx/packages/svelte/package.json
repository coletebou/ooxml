{
	"name": "docx-svelte-viewer",
	"version": "1.0.1",
	"description": "Svelte 5 component for the DOCX editor. Self-contained: includes the editor, layout engine and legacy .doc reader.",
	"keywords": [
		"doc",
		"docx",
		"editor",
		"svelte",
		"word"
	],
	"homepage": "https://christophervr.github.io/ooxml/docx/",
	"bugs": {
		"url": "https://github.com/ChristopherVR/ooxml/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/ooxml.git",
		"directory": "viewers/docx/packages/svelte"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"type": "module",
	"main": "./dist/runtime.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/WordEditor.svelte",
			"default": "./dist/WordEditor.svelte"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js"
		},
		"./package.json": "./package.json",
		"./DocumentCanvas": {
			"types": "./dist/DocumentCanvas.d.ts",
			"svelte": "./dist/DocumentCanvas.svelte",
			"default": "./dist/DocumentCanvas.svelte"
		},
		"./Toolbar": {
			"types": "./dist/Toolbar.d.ts",
			"svelte": "./dist/Toolbar.svelte",
			"default": "./dist/Toolbar.svelte"
		},
		"./PageNavigation": {
			"types": "./dist/PageNavigation.d.ts",
			"svelte": "./dist/PageNavigation.svelte",
			"default": "./dist/PageNavigation.svelte"
		},
		"./StatusBar": {
			"types": "./dist/StatusBar.d.ts",
			"svelte": "./dist/StatusBar.svelte",
			"default": "./dist/StatusBar.svelte"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"docx-core": "^0.3.0",
		"ooxml-core": "*",
		"ooxml-ui": "*"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
