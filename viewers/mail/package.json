{
	"name": "mail-viewer-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "OpenMail: an open-source mail, calendar and contacts app that speaks JMAP, built on ooxml-core",
	"license": "Apache-2.0",
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:scripts": "node --test 'scripts/*.test.mjs'",
		"build:packages": "node scripts/build-packages.mjs",
		"check:published": "node scripts/check-published-refs.mjs",
		"docs:dev": "bun run --cwd docs docs:dev",
		"docs:build": "bun run --cwd docs docs:build",
		"build:pages": "node scripts/build-pages.mjs",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test:browser": "playwright test"
	},
	"dependencies": {
		"lit": "^3.3.3",
		"ooxml-core": "*",
		"ooxml-ui": "*"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@typescript/typescript6": "^6.0.2",
		"jsdom": "^30.1.3",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rollup": "^4.64.7",
		"rollup-plugin-dts": "^6.5.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	}
}
