{
	"name": "openmail-react-viewer",
	"version": "0.1.0",
	"description": "React component and hooks for OpenMail, an open-source mail, calendar and contacts app that speaks JMAP. Self-contained: includes the <mail-app> UI.",
	"keywords": [
		"calendar",
		"contacts",
		"email",
		"jmap",
		"mail",
		"openmail",
		"react"
	],
	"homepage": "https://christophervr.github.io/ooxml/mail/",
	"bugs": {
		"url": "https://github.com/ChristopherVR/ooxml/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/ooxml.git",
		"directory": "viewers/mail/packages/react"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"lit": "^3.3.3",
		"ooxml-core": "*",
		"ooxml-ui": "*"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"engines": {
		"node": ">=20"
	}
}
