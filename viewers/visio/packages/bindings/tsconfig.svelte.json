{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"verbatimModuleSyntax": true
	},
	"include": [
		"src/**/*.ts",
		"../svelte/src/**/*.ts",
		"../svelte/src/**/*.svelte",
		"src/**/*.svelte",
