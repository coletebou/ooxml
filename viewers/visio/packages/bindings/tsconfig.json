{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"experimentalDecorators": true,
		"useDefineForClassFields": false,
		"paths": {
			"visio-core": ["../core/src/index.ts"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"tests/**/*.ts",
		"../../../../demos/visio/demo-*/**/*.ts",
		"../../../../demos/visio/demo-*/**/*.tsx",
		"vitest.config.ts",
		"vitest.ssr.config.ts",
		"../*/src/building-blocks.ts",
		"../*/src/building-blocks.tsx",
		"../*/src/building-blocks.test.ts"
	],
	"exclude": ["node_modules"]
}
