{
	"name": "@christophervr/visio-viewer",
	"version": "0.0.0",
	"private": true,
	"description": "Framework-neutral, local-first Visio viewer built on ooxml-core",
	"license": "Apache-2.0",
	"files": [
		"dist",
		"NOTICE"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly && vite build && node scripts/build-demos.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:browser": "playwright test && playwright test --config native-blocks.playwright.config.ts && node scripts/test-packages-browser.mjs",
		"check": "bun run fmt:check && bun run check:core && bun run check:converter && bun run typecheck && bun run test && bun run check:bindings && bun run test:docs && bun run build && bun run test:worker && bun run test:package && bun run build:packages && bun run test:packages",
		"check:converter": "bun run test:converter-integration",
		"check:bindings": "bun run --cwd packages/bindings check",
		"test:docs": "node --test docs/site.test.mjs docs/theme.test.mjs",
		"test:worker": "node scripts/test-worker-bundle.mjs",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test:package": "node scripts/test-package.mjs",
		"docs:dev": "bun run --cwd docs docs:dev",
		"docs:build": "node scripts/build-pages.mjs",
		"check:core": "node scripts/check-core.mjs",
		"test:corpus": "node scripts/test-corpus.mjs",
		"test:emf-audit": "node --test scripts/emf-audit/audit.test.mjs",
		"test:converter-integration": "node scripts/test-converter-integration.mjs",
		"link:core": "node scripts/link-core.mjs",
		"build:packages": "node scripts/build-packages.mjs",
		"test:packages": "node scripts/test-packages.mjs",
		"test:packages:workspace": "node scripts/test-packages.mjs --workspace-runtime && node scripts/test-packages-browser.mjs --workspace-runtime",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test:browser:building-blocks": "playwright test --config native-blocks.playwright.config.ts"
	},
	"dependencies": {
		"emf-converter": "4.21.0",
		"ooxml-core": "*",
		"ooxml-ui": "*"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.5",
		"jsdom": "^30.1.3",
		"jszip": "^3.10.2",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"postcss": "^8.5.30",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22.12"
	}
}
