{
	"name": "teams-viewer-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "OpenTeams: an open-source, bring-your-own-server team workspace (chat, calls, shared Office files) built on ooxml-core",
	"license": "Apache-2.0",
	"workspaces": [
		"packages/*",
		"server"
	],
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"server": "node server/index.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests && npm run test:server",
		"test:server": "node --test server/server.test.mjs server/hardening.test.mjs server/chat-access.test.mjs server/auth.test.mjs server/accounts.test.mjs server/session-hardening.test.mjs server/authorize-sync.test.mjs",
		"build:packages": "node scripts/build-packages.mjs",
		"docs:dev": "bun run --cwd docs docs:dev",
		"docs:build": "bun run --cwd docs docs:build",
		"build:pages": "node scripts/build-pages.mjs",
		"pack:smoke": "node scripts/pack-smoke.mjs",
		"check:published": "node scripts/check-published-refs.mjs",
		"test:scripts": "node --test 'scripts/*.test.mjs'",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test:browser": "playwright test",
		"test:browser:bindings": "node scripts/test-browser-bindings.mjs"
	},
	"dependencies": {
		"lib0": "^0.2.119",
		"lit": "^3.3.3",
		"ooxml-core": "*",
		"ooxml-ui": "*",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.33"
	},
	"devDependencies": {
		"@angular/core": "^22.2.3",
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.5",
		"@typescript/typescript6": "^6.0.2",
		"jsdom": "^30.1.3",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"rollup": "^4.64.7",
		"rollup-plugin-dts": "^6.5.1",
		"svelte": "^5.57.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	}
}
