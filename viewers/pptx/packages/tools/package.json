{
	"name": "pptx-viewer-mcp",
	"version": "2.8.9",
	"description": "pptx-viewer MCP server and tools: manipulate, convert, and collaborate on PowerPoint .pptx files from AI agents.",
	"keywords": [
		"ai",
		"collaboration",
		"converter",
		"mcp",
		"office",
		"openxml",
		"powerpoint",
		"ppt",
		"pptx",
		"pptx-viewer",
		"presentation",
		"tools"
	],
	"homepage": "https://christophervr.github.io/ooxml/pptx/",
	"bugs": {
		"url": "https://github.com/ChristopherVR/ooxml/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/ooxml.git",
		"directory": "viewers/pptx/packages/tools"
	},
	"bin": {
		"pptx-tools": "dist/mcp/cli.mjs"
	},
	"files": [
		"dist/",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./mcp": {
			"types": "./dist/mcp/index.d.ts",
			"import": "./dist/mcp/index.mjs",
			"require": "./dist/mcp/index.js"
		},
		"./codec": {
			"types": "./dist/codec/index.d.ts",
			"import": "./dist/codec/index.mjs",
			"require": "./dist/codec/index.js"
		},
		"./schemas": {
			"types": "./dist/schemas/index.d.ts",
			"import": "./dist/schemas/index.mjs",
			"require": "./dist/schemas/index.js"
		}
	},
	"scripts": {
		"build": "tsup && tsdown && node ../../scripts/merge-declarations.mjs",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit --pretty",
		"test": "vitest run",
		"test:watch": "vitest",
		"pack": "bun run build && bun pm pack"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"fast-xml-parser": "^5.11.2",
		"jszip": "^3.10.2",
		"ooxml-core": "workspace:*",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"tsdown": "^0.23.1",
		"tsup": "^9.0.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"yjs": "^13.6.33"
	},
	"peerDependencies": {
		"yjs": "^13.6.32"
	},
	"peerDependenciesMeta": {
		"yjs": {
			"optional": true
		}
	}
}
