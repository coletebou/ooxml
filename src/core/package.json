		"@types/node": "^26.6.5",
		"@types/node-forge": "^1.3.14",
		"@types/utif": "3.0.6",
		"fast-check": "^4.10.2",
		"node-forge": "^1.4.0",
		"tsdown": "^0.23.1",
		"tsup": "^9.0.0",
		"typescript": "^7.0.2",
		"unrun": "^0.3.1",
		"vitest": "^5.0.5",
		"xml-crypto": "^6.4.0",
		"xmllint-wasm": "5.3.0",
		"zod": "^4.6.7"
