	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"build:visio": "node scripts/build-visio.mjs",
		"prepack": "node scripts/ensure-built.mjs",
		"typecheck": "bun run typecheck:strict && bun run typecheck:pptx",
		"typecheck:strict": "tsc -p tsconfig.json --noEmit",
		"typecheck:pptx": "tsc -p tsconfig.pptx.json --noEmit",
		"test": "vitest run",
		"test:package": "node scripts/package-smoke.mjs",
		"gen:docx-schema-types": "bun scripts/gen-schema-types.ts"
	},
	"dependencies": {
		"@xmldom/xmldom": "^0.9.12",
