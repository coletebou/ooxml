{
	"name": "ooxml-core",
	"version": "1.19.2",
	"description": "Shared OOXML logic for the Word, PowerPoint and Excel viewers: everything except the UI",
	"keywords": [
		"charts",
		"docx",
		"drawingml",
		"office",
		"ooxml",
		"opc",
		"pptx",
		"presentationml",
		"smartart",
		"spreadsheetml",
		"wordprocessingml",
		"xls",
		"xlsx"
	],
	"homepage": "https://github.com/ChristopherVR/ooxml/tree/main/src/core#readme",
	"bugs": {
		"url": "https://github.com/ChristopherVR/ooxml/issues"
	},
	"license": "Apache-2.0",
	"author": "ChristopherVR",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherVR/ooxml.git",
		"directory": "src/core"
	},
	"bin": {
		"pptx": "./dist/pptx/cli/index.mjs"
	},
	"files": [
		"dist",
		"LICENSE",
		"NOTICE",
		"THIRD-PARTY-LICENSES",
		"README.md"
	],
	"type": "module",
